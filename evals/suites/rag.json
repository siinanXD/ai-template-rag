{
  "suite": "rag",
  "description": "Deterministic grounded RAG contract. Vector retrieval only. No paid model calls.",
  "cases": [
    {
      "id": "billing-overdue-invoice",
      "input": "Is invoice INV-88421 overdue?",
      "expected_docs": ["billing-policy"],
      "checks": [
        {"kind": "json_path", "value": "insufficient_context", "expected": false},
        {"kind": "regex", "value": "INV-88421"},
        {"kind": "json_path", "value": "citations.0.source_name", "expected": "billing-policy"},
        {"kind": "json_path", "value": "retrieved_count"}
      ],
      "tags": ["billing", "identifier"]
    },
    {
      "id": "billing-identifier-only",
      "input": "What is the status of INV-88421?",
      "expected_docs": ["billing-policy"],
