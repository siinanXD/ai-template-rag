        {"kind": "json_path", "value": "insufficient_context", "expected": false},
        {"kind": "regex", "value": "INV-88421"},
        {"kind": "json_path", "value": "citations.0.source_name", "expected": "billing-policy"}
      ],
      "tags": ["billing", "identifier"]
    },
    {
