# API
DATABASE_URL=postgresql+psycopg://starter:starter@localhost:5432/starter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Pinned to 1536 dimensions by the migration (text-embedding-3-small).
# A different model needs a new migration before EMBEDDING_DIMENSIONS can change.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30
# Optional. Cost stays unknown unless both prices are set (USD per 1M tokens).
# OPENAI_INPUT_USD_PER_MTOK=0.15
# OPENAI_OUTPUT_USD_PER_MTOK=0.60
CORS_ORIGINS=http://localhost:3000
RETRIEVAL_TOP_K=5
RERANK_ENABLED=false

# Optional Langfuse. The app runs without these.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
